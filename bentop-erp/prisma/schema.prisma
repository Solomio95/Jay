generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Access ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  role          UserRole  @default(STAFF)
  department    String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  auditLogs          AuditLog[]
  stockMovements     StockMovement[]  @relation("PerformedBy")
  approvedMovements  StockMovement[]  @relation("ApprovedBy")
  acknowledgedAlerts StockAlert[]
  ordersCreated      Order[]
  statusChanges      OrderStatusHistory[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Product Catalog ────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  skuPrefix        String
  description      String?
  categoryId       String
  brand            String   @default("Bentop Collection")
  baseCostMyr      Decimal  @db.Decimal(10, 2)
  baseCostUsd      Decimal? @db.Decimal(10, 2)
  baseCostRmb      Decimal? @db.Decimal(10, 2)
  weightKg         Decimal? @db.Decimal(6, 3)
  material         String?
  careInstructions String?
  images           Json     @default("[]")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String   @unique
  size            String
  color           String
  colorHex        String?
  barcode         String?  @unique
  additionalCost  Decimal  @default(0) @db.Decimal(10, 2)
  weightOverrideKg Decimal? @db.Decimal(6, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product     Product        @relation(fields: [productId], references: [id])
  batches     Batch[]
  stockLevels StockLevel[]
  movements   StockMovement[]
  alerts      StockAlert[]
  orderItems  OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Batch {
  id               String    @id @default(cuid())
  batchNumber      String    @unique
  productVariantId String
  quantityProduced Int
  productionDate   DateTime
  expiryDate       DateTime?
  supplierName     String?
  costPerUnitMyr   Decimal   @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime  @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  stockLevels    StockLevel[]
  movements      StockMovement[]
  orderItems     OrderItem[]

  @@index([productVariantId])
  @@map("batches")
}

// ─── Inventory ──────────────────────────────────────────────────

enum LocationType {
  WAREHOUSE
  RETAIL_STORE
  CONSIGNMENT
}

model Location {
  id            String       @id @default(cuid())
  name          String
  type          LocationType
  address       String?
  contactPerson String?
  contactPhone  String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  stockLevels    StockLevel[]
  movementsFrom  StockMovement[] @relation("FromLocation")
  movementsTo    StockMovement[] @relation("ToLocation")
  alerts         StockAlert[]
  orders         Order[]

  @@map("locations")
}

model StockLevel {
  id               String   @id @default(cuid())
  productVariantId String
  locationId       String
  batchId          String?
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderPoint     Int      @default(0)
  reorderQuantity  Int      @default(0)
  binLocation      String?
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  location       Location       @relation(fields: [locationId], references: [id])
  batch          Batch?         @relation(fields: [batchId], references: [id])

  @@unique([productVariantId, locationId, batchId])
  @@index([locationId])
  @@map("stock_levels")
}

enum MovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  RETURN
  CONSIGNMENT_OUT
  CONSIGNMENT_RETURN
}

model StockMovement {
  id               String       @id @default(cuid())
  productVariantId String
  batchId          String?
  fromLocationId   String?
  toLocationId     String?
  movementType     MovementType
  quantity         Int
  referenceNumber  String?
  reason           String?
  performedById    String
  approvedById     String?
  notes            String?
  createdAt        DateTime     @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  batch          Batch?         @relation(fields: [batchId], references: [id])
  fromLocation   Location?      @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location?      @relation("ToLocation", fields: [toLocationId], references: [id])
  performedBy    User           @relation("PerformedBy", fields: [performedById], references: [id])
  approvedBy     User?          @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([productVariantId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
}

model StockAlert {
  id               String    @id @default(cuid())
  productVariantId String
  locationId       String
  alertType        AlertType
  threshold        Int
  currentQuantity  Int
  isAcknowledged   Boolean   @default(false)
  acknowledgedById String?
  createdAt        DateTime  @default(now())
  acknowledgedAt   DateTime?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  location       Location       @relation(fields: [locationId], references: [id])
  acknowledgedBy User?          @relation(fields: [acknowledgedById], references: [id])

  @@index([isAcknowledged])
  @@map("stock_alerts")
}

// ─── Sales & Orders ─────────────────────────────────────────────

enum CustomerType {
  RETAIL
  WHOLESALE
  CONSIGNMENT
}

model Customer {
  id              String       @id @default(cuid())
  name            String
  email           String?
  phone           String?
  companyName     String?
  customerType    CustomerType @default(RETAIL)
  taxId           String?
  creditLimitMyr  Decimal?     @db.Decimal(12, 2)
  paymentTermsDays Int?
  addresses       Json         @default("[]")
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders Order[]

  @@map("customers")
}

enum ChannelType {
  PHYSICAL_STORE
  SHOPEE
  TIKTOK
  SHOPIFY
  WEBSITE
  WHOLESALE
  CONSIGNMENT
}

model SalesChannel {
  id             String      @id @default(cuid())
  name           String
  type           ChannelType
  apiConfig      Json?
  commissionRate Decimal?    @db.Decimal(5, 2)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orders Order[]

  @@map("sales_channels")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum Currency {
  MYR
  USD
  RMB
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerId       String?
  salesChannelId   String?
  locationId       String?
  status           OrderStatus   @default(DRAFT)
  currency         Currency      @default(MYR)
  exchangeRateToMyr Decimal      @default(1) @db.Decimal(10, 4)
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  discountType     DiscountType?
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  shippingAmount   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?
  paymentReference String?
  shippingAddress  Json?
  billingAddress   Json?
  notes            String?
  internalNotes    String?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer      Customer?      @relation(fields: [customerId], references: [id])
  salesChannel  SalesChannel?  @relation(fields: [salesChannelId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([salesChannelId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  batchId          String?
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalPrice       Decimal @db.Decimal(12, 2)
  costAtTimeOfSale Decimal @default(0) @db.Decimal(12, 2)
  notes            String?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  batch          Batch?         @relation(fields: [batchId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedById String
  reason     String?
  createdAt  DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// ─── Multi-Currency ─────────────────────────────────────────────

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal  @db.Decimal(10, 6)
  effectiveDate DateTime
  source       String?
  createdAt    DateTime @default(now())

  @@index([fromCurrency, toCurrency, effectiveDate])
  @@map("exchange_rates")
}
